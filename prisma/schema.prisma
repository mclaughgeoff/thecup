// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  nickname          String?
  handicap          Float
  photoUrl          String?
  isAdmin           Boolean   @default(false)
  inviteSent        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Travel
  arrivalDate       DateTime?
  arrivalTime       String?
  arrivalAirport    String?
  arrivalFlight     String?
  departureDate     DateTime?
  departureTime     String?
  departureAirport  String?
  departureFlight   String?

  // Villa assignment
  villaId           String?
  villa             Villa?    @relation(fields: [villaId], references: [id])

  // Availability
  roundAvailability RoundAvailability[]

  // Ryder Cup tournament team (at most one per player)
  ryderCupTeam      RyderCupTeamMember?

  // Per-match appearances (subset of team roster in any given match)
  matchAppearances  MatchPlayer[]

  // Scoring
  scores            Score[]

  // Chat
  chatMessages      ChatMessage[]

  // Magic links
  magicLinks        MagicLink[]
}

model Villa {
  id        String    @id @default(cuid())
  name      String
  address   String
  capacity  Int       @default(4)
  players   Player[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Round {
  id              String    @id @default(cuid())
  roundNumber     Int       // 1-8
  date            DateTime
  dayOfWeek       String    // "Wed", "Thu", "Fri", "Sat", "Sun"
  timeSlot        String    // "AM" or "PM"
  course          String    // Display string for backward compat / "TBD" rounds
  courseId        String?
  courseRef       Course?   @relation(fields: [courseId], references: [id])
  activeTeeBox    String?   // Which TeeBox.name to use for this round
  teeTime         String    // "8:15-8:41 AM" format
  isRyderCup      Boolean   @default(true)
  format          String    @default("Foursomes") // Foursomes, Four-ball, Scramble, Skins, etc.

  matches         Match[]
  availabilities  RoundAvailability[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([roundNumber])
}

model RoundAvailability {
  id        String    @id @default(cuid())
  playerId  String
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  roundId   String
  round     Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  available Boolean   @default(true)

  @@unique([playerId, roundId])
}

// Tournament-level Ryder Cup teams (exactly 2, persist across all RC rounds)
model RyderCupTeam {
  id          String   @id @default(cuid())
  name        String   // e.g. "Team Alpha" / "Team Bravo" (admin-editable)
  teamNumber  Int      // 1 or 2
  color       String?  // Hex color for UI (e.g. "#C41E3A", "#003DA5")

  members     RyderCupTeamMember[]
  matchSideA  Match[]  @relation("sideA")
  matchSideB  Match[]  @relation("sideB")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([teamNumber])
}

model RyderCupTeamMember {
  id        String        @id @default(cuid())
  teamId    String
  team      RyderCupTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId  String        @unique   // a player can only be on one team
  player    Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model Match {
  id          String   @id @default(cuid())
  roundId     String
  round       Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  matchNumber Int      // ordering within the round (1, 2, 3, 4)

  // Which RC teams are competing
  teamAId     String
  teamA       RyderCupTeam @relation("sideA", fields: [teamAId], references: [id])
  teamBId     String
  teamB       RyderCupTeam @relation("sideB", fields: [teamBId], references: [id])

  // The actual players in this match (subset of team rosters)
  players     MatchPlayer[]

  // Result
  result      String?  // "2&1", "3UP", "AS" (all square/halve), etc.
  pointsA     Float?   // Points for team A (1, 0.5, or 0)
  pointsB     Float?   // Points for team B

  // Scoring
  scores      Score[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([roundId, matchNumber])
}

model MatchPlayer {
  id        String  @id @default(cuid())
  matchId   String
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  side      String  // "A" or "B" — which RC team side they're playing for

  @@unique([matchId, playerId])
}

model Score {
  id        String    @id @default(cuid())
  matchId   String
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  hole      Int       // 1-18
  strokes   Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([matchId, playerId, hole])
}

// --- Courses & scorecards ---

model Course {
  id        String   @id @default(cuid())
  name      String   @unique
  designer  String?
  location  String?

  teeBoxes  TeeBox[]
  holes     Hole[]
  rounds    Round[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeeBox {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name       String   // "Dye", "Heritage", "Love", "Blue", "White", "Gold", etc.
  color      String?
  totalYards Int
  rating     Float?   // Course rating (e.g. 73.3) — nullable where unknown
  slope      Int?     // Slope rating (e.g. 134) — nullable where unknown

  holeYardages HoleYardage[]

  @@unique([courseId, name])
}

model Hole {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  holeNumber    Int      // 1-18
  par           Int      // 3, 4, or 5
  handicapIndex Int      // Stroke index 1-18 (which holes get strokes first)

  yardages      HoleYardage[]

  @@unique([courseId, holeNumber])
}

model HoleYardage {
  id        String  @id @default(cuid())
  holeId    String
  hole      Hole    @relation(fields: [holeId], references: [id], onDelete: Cascade)
  teeBoxId  String
  teeBox    TeeBox  @relation(fields: [teeBoxId], references: [id], onDelete: Cascade)
  yards     Int

  @@unique([holeId, teeBoxId])
}

// --- Meals (lunches + dinners) ---

model MealReservation {
  id          String   @id @default(cuid())
  date        DateTime
  dayOfWeek   String   // "Wed", "Thu", etc.
  mealType    String   // "lunch" or "dinner"
  time        String   // "7:30 PM" or "TBD"
  restaurant  String
  address     String?
  notes       String?
  headcount   Int?
  confirmed   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ChatMessage {
  id        String    @id @default(cuid())
  playerId  String
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model MagicLink {
  id        String    @id @default(cuid())
  token     String    @unique
  playerId  String
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
